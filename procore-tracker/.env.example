# Copia este archivo a ".env" y completa los valores. NUNCA subas el ".env" real al repo.

# Credenciales de la app registrada en https://developers.procore.com
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=

# IDs de tu compañía y proyecto en Procore (se ven en la URL al entrar al proyecto,
# ej. https://app.procore.com/<company_id>/projects/<project_id>/...)
PROCORE_COMPANY_ID=
PROCORE_PROJECT_ID=

# Por defecto apunta a producción. Para probar gratis primero contra el Sandbox
# que Procore te da automáticamente, usa las credenciales/URLs de Sandbox
# (https://sandbox.procore.com para ambas).
PROCORE_BASE_URL=https://api.procore.com
PROCORE_OAUTH_URL=https://login.procore.com

# Cómo se autentica el script:
# - authorization_code (default): corre `python authorize.py` una vez para
#   iniciar sesión con tu usuario; después el script se renueva solo con un
#   refresh token guardado localmente. No requiere nada especial de Procore.
# - client_credentials: solo si Procore te habilitó una Developer Managed
#   Service Account (DMSA) para esta app (hay que pedirla, no es self-service).
PROCORE_AUTH_MODE=authorization_code

# Redirect URI configurado en el Developer Portal. El valor por defecto es el
# flujo "installed app" de Procore: en vez de redirigir a una URL, te muestra
# el código en pantalla para pegarlo en authorize.py. No hace falta cambiarlo.
PROCORE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Rutas de la REST API. Procore versiona sus endpoints y a veces cambian según
# el plan/instancia — si el script te da un 404, verifica y ajusta aquí contra
# https://developers.procore.com/reference/rest
PROCORE_RFIS_PATH=/rest/v1.0/projects/{project_id}/rfis
PROCORE_SUBMITTALS_PATH=/rest/v1.1/projects/{project_id}/submittals
PROCORE_DRAWINGS_PATH=/rest/v1.0/projects/{project_id}/drawings

# Regex para reconocer números de plano dentro del título/asunto de un RFI o
# Submittal (por defecto agarra cosas como "A-101", "S201", "M-3.2").
# Ajústalo al formato de numeración de tus planos.
PROCORE_DRAWING_NUMBER_REGEX=\b[A-Z]{1,3}-?\d{2,4}(?:\.\d{1,2})?\b
