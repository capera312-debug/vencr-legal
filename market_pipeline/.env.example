# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# --- Alpaca (usa las keys de tu cuenta PAPER, no la real) ---
ALPACA_API_KEY=...
ALPACA_SECRET_KEY=...
ALPACA_PAPER=true

# --- Ejecución ---
# Si es false (default), el pipeline analiza y loguea pero pide confirmación
# manual antes de mandar cualquier orden, incluso en paper trading.
AUTO_EXECUTE=false

# Salvaguarda extra: aunque pongas ALPACA_PAPER=false, el pipeline se niega
# a mandar órdenes reales a menos que esto también esté en true. Es a
# propósito redundante con ALPACA_PAPER.
CONFIRM_LIVE_TRADING=false

# --- Risk gate (límites duros, ver src/risk/risk_gate.py) ---
RISK_MAX_POSITION_PCT=0.05
RISK_MAX_TOTAL_EXPOSURE_PCT=0.30
RISK_MIN_CONFIDENCE=0.65
RISK_MAX_DAILY_TRADES=5
